# ─── Required ─────────────────────────────────────────────
# Get Gemini key FREE at: aistudio.google.com → Get API Key (no credit card)
GEMINI_API_KEY=AIza...
FINNHUB_API_KEY=your_finnhub_key_here

# ─── Email notifications (optional — leave blank to disable) ──
EMAIL_SENDER=you@gmail.com
EMAIL_PASSWORD=your_gmail_app_password   # NOT your normal Gmail password — use App Password
EMAIL_RECIPIENT=you@gmail.com

# ─── Scheduler settings ───────────────────────────────────
SCAN_INTERVAL_MINUTES=10

# ─── Watchlist (comma-separated, or set via UI) ───────────
# WATCHLIST=["AAPL","MSFT","NVDA","TSLA","AMD","GOOGL","META","AMZN"]
